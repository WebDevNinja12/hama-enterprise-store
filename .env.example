# === Required ===
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-as-AUTH_SECRET-or-separate"
NEXTAUTH_URL="https://hama-enterprise-store.vercel.app"

# === Email (Resend) ===
RESEND_API_KEY="re_xxxx"
EMAIL_FROM="HAMA Store <onboarding@resend.dev>"

# === Vercel Blob (product images) ===
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"

# === Google login (optional until keys added) ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === OPay payment (add when ready) ===
OPAY_MERCHANT_ID=""
OPAY_PUBLIC_KEY=""
OPAY_SECRET_KEY=""
OPAY_ENV="sandbox"

# === Optional Redis (rate limits persist better) ===
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# === Cron cleanup ===
CRON_SECRET="random-string"

# === Emergency admin password reset (REMOVE after use) ===
ADMIN_BOOTSTRAP_SECRET=""
