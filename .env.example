# Copy to .env locally. NEVER put real values in GitHub.
# On Vercel: Project → Settings → Environment Variables

# --- Database (required) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Optional direct connection for migrations
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Auth (required) ---
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"
# Production example:
# NEXTAUTH_URL="https://hama-enterprise-store.vercel.app"

# --- Google login (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email / Resend (optional but needed for OTP & order emails) ---
RESEND_API_KEY=""
EMAIL_FROM="HAMA ENTERPRISE NG <onboarding@resend.dev>"
# ADMIN_NOTIFY_EMAIL=""

# --- Vercel Blob (optional; product image uploads) ---
BLOB_READ_WRITE_TOKEN=""

# --- OPay payment gateway (optional until you enable checkout pay) ---
# Get these from OPay merchant dashboard. Never commit real keys.
OPAY_MERCHANT_ID=""
OPAY_PUBLIC_KEY=""
OPAY_SECRET_KEY=""
OPAY_ENV="sandbox"

# --- Redis / Upstash (optional; rate limits persist better) ---
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
